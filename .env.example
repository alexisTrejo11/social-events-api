# =============================================================================
# ENVIRONMENT CONFIGURATION
# =============================================================================
# Copy this file to .env and fill in the actual values
# Never commit .env to version control!

# =============================================================================
# DJANGO CORE SETTINGS
# =============================================================================
DEBUG=True
SECRET_KEY=django-insecure-CHANGE-THIS-IN-PRODUCTION-xyz123
# Use 'development' for local dev, 'production' for Docker
DJANGO_SETTINGS_MODULE=config.settings.development
ALLOWED_HOSTS=localhost,127.0.0.1

# =============================================================================
# DATABASE - DEVELOPMENT (SQLite)
# =============================================================================
# For local development with SQLite, leave DATABASE_URL commented or empty
# DATABASE_URL=sqlite:///db.sqlite3

# =============================================================================
# DATABASE - PRODUCTION (PostgreSQL for Docker)
# =============================================================================
# For Docker/Production, uncomment and configure these:
# DJANGO_SETTINGS_MODULE=config.settings.production
# DATABASE_URL=postgresql://postgres:postgres@postgres:5432/social_events_db

# PostgreSQL individual variables (used by Docker Compose)
POSTGRES_DB=social_events_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Alternative PostgreSQL variables for compatibility
DB_NAME=social_events_db
DB_USER=postgres
DB_PASSWORD=postgres

# =============================================================================
# REDIS (Cache + Celery Broker)
# =============================================================================
# Development (local Redis)
REDIS_URL=redis://localhost:6379/1
CELERY_BROKER_URL=redis://localhost:6379/0

# Production (Docker Redis) - uncomment when using Docker
# REDIS_HOST=redis
# REDIS_PORT=6379
# REDIS_URL=redis://redis:6379/1
# CELERY_BROKER_URL=redis://redis:6379/0

# =============================================================================
# DOCKER CONFIGURATION
# =============================================================================
CREATE_SUPERUSER=false
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=admin123
POPULATE_DB=false

# =============================================================================
# JWT TOKENS
# =============================================================================
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# =============================================================================
# AWS S3 (for media storage - optional)
# =============================================================================
USE_S3=false
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=us-east-1

# =============================================================================
# EMAIL CONFIGURATION
# =============================================================================
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@example.com
EMAIL_HOST_PASSWORD=your-email-password
DEFAULT_FROM_EMAIL=noreply@socialevents.com

# =============================================================================
# SECURITY SETTINGS (Production only)
# =============================================================================
# For HTTPS/SSL configuration, see: docs/HTTPS_SETUP.md
DOMAIN_NAME=midominio.com
SECURE_SSL_REDIRECT=false
SESSION_COOKIE_SECURE=false
CSRF_COOKIE_SECURE=false
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=true
SECURE_HSTS_PRELOAD=true

# =============================================================================
# FRONTEND (for email verification links, etc.)
# =============================================================================
FRONTEND_URL=http://localhost:3000

# =============================================================================
# OAUTH2 / SOCIAL AUTHENTICATION
# =============================================================================
# For detailed setup instructions, see: docs/OAUTH_SETUP.md

# OPTION 1: Configure via Django Admin (✅ RECOMMENDED)
# ----------------------------------------------------------------------------
# 1. Run migrations: python manage.py migrate
# 2. Create superuser: python manage.py createsuperuser
# 3. Go to: http://localhost:8000/admin/socialaccount/socialapp/
# 4. Add Social Applications for Google and GitHub with your credentials
# 5. Make sure to configure the Site (Sites framework)

# OPTION 2: Configure via Environment Variables (Advanced)
# ----------------------------------------------------------------------------
# Uncomment these if you prefer to manage OAuth apps programmatically
# Note: You'll need to create SocialApp instances in code/migrations

# Google OAuth2 Credentials
# Get from: https://console.cloud.google.com/ → APIs & Services → Credentials
# GOOGLE_OAUTH_CLIENT_ID=123456789-abc123.apps.googleusercontent.com
# GOOGLE_OAUTH_CLIENT_SECRET=GOCSPX-YourSecretKeyHere

# GitHub OAuth Credentials  
# Get from: https://github.com/settings/developers → OAuth Apps
# GITHUB_OAUTH_CLIENT_ID=Iv1.a1b2c3d4e5f6g7h8
# GITHUB_OAUTH_CLIENT_SECRET=ghp_YourSecretKeyHere1234567890abcdefgh

# OAuth Callback URLs (for reference - configure in provider console):
# Google: http://localhost:8000/accounts/google/login/callback/
# GitHub: http://localhost:8000/accounts/github/login/callback/
# Production: https://yourdomain.com/accounts/{google|github}/login/callback/

# =============================================================================
# RATE LIMITING
# =============================================================================
# Override default throttle rates if needed
# THROTTLE_AUTHENTICATED_DAY=1000/day
# THROTTLE_ANON_DAY=100/day
# THROTTLE_AUTH_ACTIONS_MINUTE=10/minute
